# The checkout service. Install: sudo cp deploy/checkout/checkout-api.service /etc/systemd/system/
# (see "Running it on the server" in apps/checkout/README.md).
[Unit]
Description=Checkout service (payments for every product)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/pos/apps/checkout/api
EnvironmentFile=/opt/pos/apps/checkout/api/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
