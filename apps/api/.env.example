DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_db?schema=public"
PORT=3001
# Signs login tokens. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# How long a login lasts before the user must sign in again (default 12)
AUTH_TOKEN_TTL_HOURS=12
# Password for the first admin, used only when the database has no users.
# If empty, a random password is generated and printed once at startup.
SEED_ADMIN_PASSWORD=
