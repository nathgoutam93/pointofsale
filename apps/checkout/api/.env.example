# The checkout service's own database (not a product's).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checkout_db?schema=public"
# 8004 is the API gateway's upstream for /v1/checkout (deploy/gateway/nginx-api-gateway.conf).
PORT=8004
HOST=127.0.0.1
# This service's address as payers' browsers reach it (payment links start with it).
CHECKOUT_PUBLIC_URL=https://api.hackd.in/v1/checkout
# The payment provider: "dummy" (test payments, no money moves; never where real customers pay).
# A real one (Razorpay) is added in src/providers/.
CHECKOUT_PROVIDER=dummy
# The products that take payments here, comma-separated. Each has three settings, named after it
# (CHECKOUT_<PRODUCT>_…): the API key it calls with, the secret its notices are signed with
# (each at least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ), and where its notices go. The product gets the same key and secret in its own settings.
CHECKOUT_PRODUCTS=pos
CHECKOUT_POS_API_KEY=
CHECKOUT_POS_NOTIFY_SECRET=
# On the same server the product can be reached directly, without the gateway.
CHECKOUT_POS_NOTIFY_URL=http://127.0.0.1:3001/billing/webhooks/checkout
# How often notices a product didn't take are sent again, in seconds (default 30).
CHECKOUT_NOTIFY_INTERVAL_SECONDS=
