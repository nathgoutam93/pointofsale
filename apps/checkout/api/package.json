{
  "name": "@hackd/checkout-api",
  "version": "0.0.1",
  "private": true,
  "description": "One checkout for every product: payment sessions, the payer's page, the payment provider and signed notices back to products.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate": "prisma migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@hackd/checkout-contracts": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "express": "4.22.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@swc/core": "^1.16.13",
    "@types/express": "^4",
    "@types/node": "^22.10.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2"
  }
}
