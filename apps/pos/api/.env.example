DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_db?schema=public"
PORT=3001
# Signs login tokens. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# How long a login lasts before the user must sign in again (default 12)
AUTH_TOKEN_TTL_HOURS=12
# offline: a desktop install (one branch, one counter, first-run setup, listens on 127.0.0.1 only).
# online: the hosted server. Default online.
POS_MODE=online
# Online only: managed on our hosted service (sign-up, subscriptions); self (the default) on a
# business's own server. The apps go by this, not by the server's address.
POS_HOSTING=
# Managed hosting only: the payment gateway subscriptions are paid through: "checkout" (our checkout
# service, below). Unset, nothing is charged or enforced (no trial end, no plan limits, no
# read-only). "dummy" is a stand-in for
# development and testing: its checkout page is on this server and no money moves, so never use
# it where real businesses pay.
BILLING_GATEWAY=
# BILLING_GATEWAY=checkout: payments through our checkout service (apps/checkout), shared by every
# product. Its address (on the same server: http://127.0.0.1:8004; or through the API gateway:
# https://api.hackd.in/v1/checkout), and the API key and notify secret it has for the POS (its
# CHECKOUT_POS_API_KEY and CHECKOUT_POS_NOTIFY_SECRET). Its notices come to /billing/webhooks/checkout.
CHECKOUT_URL=
CHECKOUT_API_KEY=
CHECKOUT_NOTIFY_SECRET=
# Who sells the subscription, printed on its invoices. With a GSTIN, prices carry 18% GST and
# invoices are tax invoices; without one, no GST is charged and they are receipts. BILLING_SAC
# prints the service code; BILLING_INVOICE_PREFIX starts invoice numbers (default POS, 4 letters at most).
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=
BILLING_SAC=
BILLING_INVOICE_PREFIX=
# Interface to listen on. Offline installs only accept 127.0.0.1, ::1 or localhost. PORT=0 picks a free port.
HOST=
# Comma-separated web origins allowed to call the API. Only these may use the sign-in cookie.
# Empty: any origin online (bearer tokens only); offline, only the web dev server.
CORS_ORIGINS=
# The sign-in cookie. Secure is automatic behind HTTPS (or X-Forwarded-Proto: https); true or
# false forces it. SameSite: lax (default), strict, or none for a web app on another site.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
# Online only: clients older than this version (x.y.z) must update.
MIN_CLIENT_VERSION=
# Online only. Each business has its own schema; a client per business is kept for the most
# recently used ones (default 100), each with a small connection pool (default 3). Their product
# is how many connections can be open: keep it under PostgreSQL's max_connections (100 by
# default), or use PgBouncer (README, "Hosting the online server", step 12).
TENANT_CLIENT_CACHE=
TENANT_CONNECTION_LIMIT=
# Behind PgBouncer: a direct URL to PostgreSQL for migrations (deploy/pos/deploy.sh uses it).
MIGRATE_DATABASE_URL=
# Online only, optional: the control schema's URL (default: DATABASE_URL with schema=control).
CONTROL_DATABASE_URL=
# Online only: email, for owner password reset codes. An SMTP URL such as
# smtps://user:password@smtp.example.com:465, and the sender. Without it, owners can't reset
# a forgotten password (staff passwords don't need email).
SMTP_URL=
MAIL_FROM="Point of Sale <no-reply@example.com>"
# Development: MAIL_TRANSPORT=log prints emails to the API's log instead of sending them.
MAIL_TRANSPORT=
# Online only: owners prove their email with an emailed code before it creates a business or
# moves one online (once per address). "off" turns that off, e.g. developing without email.
OWNER_EMAIL_VERIFICATION=
