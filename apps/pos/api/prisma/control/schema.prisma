// The control schema of the hosted (online) server: which businesses exist, where their
// data lives (one PostgreSQL schema each) and who owns them. Business data itself is in
// ../schema.prisma, applied to every business's schema.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/control-client"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL with ?schema=control; set by the API and the migration runner.
  url      = env("CONTROL_DATABASE_URL")
}

/// PROVISIONING: being created. ACTIVE: in use. SUSPENDED: sign-in refused. FAILED: creation failed.
enum BusinessStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  /// The owner asked for it to be deleted: locked, erased at deleteAfter unless they cancel.
  DELETING
  /// Erased: its data is gone; the row stays for the platform's own billing records.
  DELETED
}

enum MembershipRole {
  OWNER
}

model Business {
  id                   String            @id @default(uuid())
  /// Short code staff type when signing in, e.g. K7Q2MX.
  code                 String            @unique
  name                 String
  /// The PostgreSQL schema holding this business's data, e.g. b_3f2a….
  schemaName           String            @unique
  /// Which database server holds the schema; "default" is DATABASE_URL. Lets businesses move
  /// to another server later without changing anything else.
  dbServer             String            @default("default")
  status               BusinessStatus    @default(PROVISIONING)
  /// The last migration applied to the business's schema.
  schemaVersion        String?
  /// Set when the business came from an offline install (moved online). A retried upload with
  /// the same id returns this business instead of creating a second one.
  importId             String?           @unique
  /// Managed hosting: the plan whose limits apply (PLANS in @pos/contracts), the end of the free
  /// trial and the end of the time paid for. Self-hosted servers ignore all three.
  plan                 String            @default("growth")
  trialEndsAt          DateTime?
  paidUntil            DateTime?
  /// The last billing reminder emailed (its kind and the date it was about), so each goes once.
  billingNotice        String?
  /// Deletion: who asked (an owner account), the status to go back to if they cancel, when it
  /// will be erased, and when it was.
  deletionRequestedBy  String?
  statusBeforeDeletion BusinessStatus?
  deleteAfter          DateTime?
  erasedAt             DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  memberships          Membership[]
  checkouts            BillingCheckout[]
  invoices             BillingInvoice[]
}

/// A business owner's sign-in (email and password), separate from the staff users inside a
/// business. Used to create businesses and, later, to move an offline business online.
model Account {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  /// Owner tokens signed before this stop working (a reset signs the owner out everywhere).
  passwordChangedAt DateTime?
  createdAt         DateTime        @default(now())
  memberships       Membership[]
  passwordResets    PasswordReset[]
  deletionCodes     DeletionCode[]
}

/// A code emailed to an owner who forgot their password. Only its hash is kept; it works once,
/// for 15 minutes, and allows a few wrong tries. A new request replaces older codes.
model PasswordReset {
  id        String    @id @default(uuid())
  accountId String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// A code emailed to an owner to confirm deleting one of their businesses (with their password).
/// Only its hash is kept; it works once, for 15 minutes, with a few tries.
model DeletionCode {
  id         String    @id @default(uuid())
  accountId  String
  businessId String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, businessId])
}

model Membership {
  accountId  String
  businessId String
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now())
  account    Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([accountId, businessId])
  @@index([businessId])
}

/// A code emailed to prove an owner owns their email address, asked for the first time the
/// address creates a business or moves one online (the account may not exist yet, so it is
/// keyed by email). Only its hash is kept; it works once, for 15 minutes, with a few tries.
model EmailVerification {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
}

/// One attempt to pay for a plan: created when an admin presses Pay, settled by the payment
/// gateway's webhook (never by the app). Amounts in paise.
model BillingCheckout {
  id          String          @id @default(uuid())
  businessId  String
  plan        String
  /// month | year
  period      String
  amount      Int
  gst         Int
  total       Int
  /// Which gateway it went through (BILLING_GATEWAY when it was made) and the gateway's own id for it.
  gateway     String
  gatewayRef  String?
  /// The gateway's page the payer is sent to.
  redirectUrl String?
  status      CheckoutStatus  @default(PENDING)
  createdAt   DateTime        @default(now())
  settledAt   DateTime?
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice     BillingInvoice?

  @@unique([gateway, gatewayRef])
  @@index([businessId])
}

/// Each gateway event (webhook) handled, so a retried delivery changes nothing.
model BillingEvent {
  gateway    String
  eventId    String
  receivedAt DateTime @default(now())

  @@id([gateway, eventId])
}

/// Our tax invoice for a payment, numbered per financial year. Buyer details are copied from
/// the business when it is issued.
model BillingInvoice {
  id         String          @id @default(uuid())
  number     String          @unique
  businessId String
  checkoutId String          @unique
  issuedAt   DateTime        @default(now())
  buyerName  String
  buyerGstin String?
  /// Two-digit GST state code of the buyer (place of supply); null when unknown.
  buyerState String?
  plan       String
  period     String
  periodFrom DateTime
  periodTo   DateTime
  /// Paise: before GST, the tax split, and what was paid.
  amount     Int
  cgst       Int
  sgst       Int
  igst       Int
  total      Int
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  checkout   BillingCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// The last invoice number issued in each financial year (its start year).
model BillingInvoiceSequence {
  fiscalYear Int @id
  last       Int @default(0)
}

/// A crash report from an app or this server (see crashReportSchema in contracts): the error's
/// first line and stack frames, scrubbed; never customer data. Kept 90 days.
model CrashReport {
  id          String   @id @default(uuid())
  /// desktop, local-api, page or server.
  source      String
  appVersion  String
  /// offline, online, fallback, browser or server.
  mode        String
  os          String
  message     String
  stack       String
  /// The message and the top frame, hashed: the same crash from anywhere groups together.
  fingerprint String
  installId   String?
  businessId  String?
  occurredAt  DateTime
  receivedAt  DateTime @default(now())

  @@index([receivedAt])
  @@index([fingerprint])
}
