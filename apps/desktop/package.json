{
  "name": "@pos/desktop",
  "productName": "Point of Sale",
  "version": "0.1.1",
  "private": true,
  "description": "Point of Sale desktop app",
  "author": "Point of Sale",
  "type": "module",
  "main": "dist/main.js",
  "posServerUrl": "https://pos.hackd.in",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "tsc -p tsconfig.json && node scripts/stage.mjs && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "^44",
    "electron-builder": "^26",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "16.14.0-beta.17",
    "@embedded-postgres/darwin-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-arm64": "16.14.0-beta.17",
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@embedded-postgres/windows-x64": "16.14.0-beta.17"
  }
}
