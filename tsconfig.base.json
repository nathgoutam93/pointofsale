{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@pos/types": [
        "apps/pos/types/src"
      ],
      "@pos/contracts": [
        "apps/pos/contracts/src"
      ],
      "@hackd/checkout-contracts": [
        "packages/checkout-contracts/src"
      ]
    }
  }
}
